  <RecipeDef>
    <defName>Bulgur_CookLavishMeat</defName>
    <label>cook a lavish meal from bulgur with meat</label>
    <description>Pour boiling water over the bulgur while the meat cooks. Much faster than the usual recipe.</description>
    <jobString>Cooking a lavish bulgur and meat meal.</jobString>
    <workAmount>240</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <skillRequirements>
      <Cooking>8</Cooking>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <customSummary>protein</customSummary>
          <categories>
            <li>MeatRaw</li>
            <li>AnimalProductRaw</li>
          </categories>
        </filter>
        <count>0.5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>BulgurSteamed</li>
          </thingDefs>
        </filter>
        <count>0.5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
        <li>AnimalProductRaw</li>
      </categories>
      <thingDefs>
        <li>BulgurSteamed</li>
      </thingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
        <li>MeatRaw</li>
        <li>AnimalProductRaw</li>
      </categories>
      <thingDefs>
        <li>BulgurSteamed</li>
      </thingDefs>
      <disallowedCategories>
        <li>EggsFertilized</li>
      </disallowedCategories>
      <disallowedThingDefs>
        <li>Meat_Human</li>
        <li>Meat_Megaspider</li>
        <li>InsectJelly</li>
        <li MayRequire="Ludeon.RimWorld.Anomaly">Meat_Twisted</li>
      </disallowedThingDefs>
    </defaultIngredientFilter>
    <products>
      <MealLavish>1</MealLavish>
    </products>
    <displayPriority>94</displayPriority>
  </RecipeDef>

