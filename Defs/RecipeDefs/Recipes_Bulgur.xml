<?xml version="1.0" encoding="utf-8"?>
<Defs>


  <RecipeDef>
    <defName>Bulgur_Steam</defName>
    <label>steam bulgur</label>
    <description>Steam 10 bulgur grains into a cup of bulgur.</description>
    <jobString>Steaming bulgur.</jobString>
    <workAmount>90</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RawBulgurGrain</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RawBulgurGrain</li>
      </thingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <thingDefs>
        <li>RawBulgurGrain</li>
      </thingDefs>
    </defaultIngredientFilter>
    <products>
      <BulgurSteamed>1</BulgurSteamed>
    </products>
    <displayPriority>90</displayPriority>
  </RecipeDef>

