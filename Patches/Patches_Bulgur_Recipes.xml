  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>/Defs/ThingDef[recipes/li="CookMealLavish"]/recipes</xpath>
    <value>
      <li>Bulgur_CookLavishMeat</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>/Defs/ThingDef[recipes/li="CookMealLavishBulk"]/recipes</xpath>
    <value>
      <li>Bulgur_CookLavishMeatBulk</li>
    </value>
