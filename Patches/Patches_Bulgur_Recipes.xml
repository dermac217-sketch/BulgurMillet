<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>/Defs/ThingDef[recipes/li="CookMealSimple"]/recipes</xpath>
    <value>
      <li>Bulgur_Steam</li>
      <li>Bulgur_CookSimple</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>/Defs/ThingDef[recipes/li="CookMealSimpleBulk"]/recipes</xpath>
